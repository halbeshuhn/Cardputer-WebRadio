+
+    // Stille statt Wiederholung, wenn der Nachschub ausbleibt.
+    //
+    // I2S_CHANNEL_DEFAULT_CONFIG laesst auto_clear auf false. Der DMA sendet
+    // dann den zuletzt geschriebenen Puffer erneut, solange niemand nachlegt -
+    // bei 5 Puffern zu 2.304 Bytes sind das 26 ms Ton in Endlosschleife. Das
+    // ist das Rasseln, das man bei jeder Funkdelle hoert.
+    //
+    // Mit auto_clear nullt die ISR den Puffer, sobald er gesendet ist
+    // (esp_driver_i2s/i2s_common.c, i2s_dma_tx_callback: memset(curr_buf, 0,
+    // buf_size) hinter auto_clear_after_cb). Kommt nichts nach, laeuft Stille
+    // aus dem Ausgang. Kosten: 77 memset zu 2.304 Bytes je Sekunde.
+    //
+    // auto_clear ist in der IDF ein Alias von auto_clear_after_cb; der
+    // Kurzname gilt auch in aelteren Fassungen.
+    chan_cfg.auto_clear = true;
     assert(ESP_OK == i2s_new_channel(&chan_cfg, &_tx_handle, nullptr));
 
